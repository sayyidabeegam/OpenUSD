#usda 1.0
def Xform "World" {
    def Xform "Lamp" ( active = false ) {
        def Sphere "Bulb" {}
    }
    def Xform "Tree" ( payload = @payload.usda@ ) {}
    over "Ghost" {
        def Sphere "Inside" {}
    }
    def Xform "Car" (
        variants = { string trim = "base" }
        prepend variantSets = "trim"
    ) {
        variantSet "trim" = {
            "base" { }
            "sport" {
                def Cube "Spoiler" {}
            }
        }
    }
}
